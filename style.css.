
/* Main website design */
body {
    background-color: #f0f4ff;
    font-family: Arial, sans-serif;
    text-align: center;
    padding: 30px;
    margin: 0;
}

/* Main heading */
h1 {
    color: #ffffff;
    background-color: #174ea6;
    padding: 25px;
    border-radius: 12px;
}

/* Subheadings */
h2 {
    color: #e67e22;
    margin-top: 30px;
}

/* Paragraphs */
p {
    color: #333333;
    font-size: 18px;
    line-height: 1.7;
}

/* Learning list */
ul {
    background-color: #ffffff;
    padding: 25px;
    border-radius: 12px;
    display: inline-block;
    text-align: left;
}

/* List items */
li {
    margin: 12px;
    color: #174ea6;
}

/* Mobile-friendly layout */
@media (max-width: 600px) {
    body {
        padding: 15px;
    }

    h1 {
        font-size: 25px;
    }
}
